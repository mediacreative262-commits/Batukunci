rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function authEmail() { return request.auth.token.email; }
    function legacyOwner() { return authEmail() == 'muhammadfadlimustafidin-mdc.26.2@batukunci.app'; }

    match /chats/{chatId} {
      // Group chat: only members can see the group. DM remains available to
      // signed-in users for compatibility with the existing Batu Kunci chat.
      allow read: if signedIn() && (
        resource.data.type != 'group' ||
        authEmail() in resource.data.memberEmails ||
        (legacyOwner() && !('memberEmails' in resource.data))
      );

      // Anyone logged in can create a group, but the creator must include
      // themselves as a member + admin.
      allow create: if signedIn() && (
        request.resource.data.type != 'group' || (
          authEmail() in request.resource.data.memberEmails &&
          authEmail() in request.resource.data.adminEmails
        )
      );

      // Group info/member/admin changes and deletion are admin-only.
      allow update: if signedIn() && (
        resource.data.type != 'group' ||
        authEmail() in resource.data.adminEmails ||
        (legacyOwner() && !('adminEmails' in resource.data))
      );

      allow delete: if signedIn() && (
        resource.data.type != 'group' || authEmail() in resource.data.adminEmails
      );

      match /messages/{messageId} {
        // Group messages are readable/writable only by group members.
        allow read, create: if signedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'group' ||
          authEmail() in get(/databases/$(database)/documents/chats/$(chatId)).data.memberEmails
        );
        allow update, delete: if signedIn();
      }
    }

    // Existing Batu Kunci collections keep their previous signed-in write behaviour.
    match /users/{userId} { allow read: if true; allow write: if signedIn(); }
    match /driveAccounts/{docId} { allow read: if true; allow write: if signedIn(); }
    match /albums/{docId} { allow read: if true; allow write: if signedIn(); }
    match /gallery/{docId} { allow read: if true; allow write: if signedIn(); }
    match /notifications/{docId} { allow read: if true; allow write: if signedIn(); }
    match /projects/{projectId} { allow read: if true; allow write: if signedIn(); }
    match /projects/{projectId}/comments/{commentId} { allow read: if true; allow write: if signedIn(); }
  }
}
