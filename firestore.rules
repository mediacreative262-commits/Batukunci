rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function authEmail() { return request.auth.token.email; }
    function accessPath() { return /databases/$(database)/documents/accountAccess/$(request.auth.token.email); }
    function accessExists() { return signedIn() && exists(accessPath()); }
    function activeAccount() {
      return signedIn() && accessExists() && get(accessPath()).data.active == true;
    }
    function currentUserId() {
      return get(accessPath()).data.userId;
    }
    function workspaceAdmin() {
      return activeAccount() && (
        authEmail() == 'muhammadfadlimustafidin-mdc.26.2@batukunci.app' ||
        get(accessPath()).data.role == 'admin'
      );
    }
    function chatMember(chatId) {
      return activeAccount() && authEmail() in get(/databases/$(database)/documents/chats/$(chatId)).data.memberEmails;
    }

    // Access registry: account owner can create their own default member record.
    // Only workspace admins can change active state or role.
    match /accountAccess/{email} {
      allow read: if signedIn() && (authEmail() == email || workspaceAdmin());
      allow create: if (authEmail() == 'muhammadfadlimustafidin-mdc.26.2@batukunci.app') || (workspaceAdmin() && request.resource.data.role == 'member') || (signedIn() && authEmail() == email
        && request.resource.data.active == true
        && request.resource.data.role == 'member');
      allow update: if workspaceAdmin() && (authEmail() == 'muhammadfadlimustafidin-mdc.26.2@batukunci.app' || request.resource.data.role == resource.data.role);
      allow delete: if authEmail() == 'muhammadfadlimustafidin-mdc.26.2@batukunci.app';
    }

    match /chats/{chatId} {
      allow read: if activeAccount() && (authEmail() in resource.data.memberEmails || workspaceAdmin());
      allow create: if activeAccount() && authEmail() in request.resource.data.memberEmails
        && (request.resource.data.type != 'group' || authEmail() in request.resource.data.adminEmails);
      allow update: if activeAccount() && (
        workspaceAdmin() ||
        (resource.data.type == 'group' && authEmail() in resource.data.adminEmails) ||
        (resource.data.type == 'dm' && authEmail() in resource.data.memberEmails && authEmail() in request.resource.data.memberEmails)
      );
      allow delete: if activeAccount() && (workspaceAdmin() || (resource.data.type == 'group' && authEmail() in resource.data.adminEmails));

      match /messages/{messageId} {
        allow read, create: if chatMember(chatId);
        allow update, delete: if chatMember(chatId) && (
          workspaceAdmin() || resource.data.senderId == currentUserId()
        );
      }
    }

    // Public profile list is needed by the read-only View and member picker.
    // Members can only edit their own profile fields; workspace admins manage status/records.
    match /users/{userId} {
      allow read: if true;
      allow create: if workspaceAdmin();
      allow update: if workspaceAdmin() || (
        activeAccount() && authEmail() == userId + '@batukunci.app' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'bio', 'music', 'bg', 'photo', 'notificationEnabled', 'fcmToken', 'fcmTokenUpdatedAt'
        ])
      );
      allow delete: if workspaceAdmin();
    }


    // Jadwal pengurus adalah konfigurasi workspace bersama; semua anggota aktif dapat membaca dan mengedit.
    match /workspaceSettings/{settingId} {
      allow read, write: if activeAccount() && settingId == 'dutySchedule';
    }

    match /driveAccounts/{docId} {
      allow read: if true;
      allow write: if activeAccount() && workspaceAdmin();
    }
    match /albums/{docId} {
      allow read: if true;
      allow create, update, delete: if activeAccount() && workspaceAdmin();
    }
    match /gallery/{docId} {
      allow read: if true;
      allow create: if activeAccount();
      allow update: if activeAccount() && workspaceAdmin();
      allow delete: if activeAccount();
    }
    match /notifications/{docId} {
      allow read: if activeAccount() && (resource.data.userId == currentUserId() || workspaceAdmin());
      allow create: if activeAccount();
      allow update: if activeAccount() && resource.data.userId == currentUserId();
      allow delete: if activeAccount() && workspaceAdmin();
    }
    match /projects/{projectId} {
      allow read: if true;
      allow write: if activeAccount();
      match /comments/{commentId} {
        allow read: if true;
        allow write: if activeAccount();
      }
    }
  }
}