rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Siapa aja boleh BACA (perlu buat Mode View yang publik & gak login).
    // Yang boleh NULIS/UBAH cuma yang udah login (6 akun Tim Media Kreatif).
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
