rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeAccount() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/accountAccess/$(request.auth.token.email)).data.active == true;
    }
    match /chatMedia/{chatId}/{userId}/{fileName} {
      function chatMembers() {
        return activeAccount() &&
          request.auth.token.email in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberEmails;
      }
      allow read: if chatMembers();
      allow write: if chatMembers() && request.auth.uid == userId && request.resource.size < 50 * 1024 * 1024;
    }
  }
}