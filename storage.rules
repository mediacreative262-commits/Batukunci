rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chatMedia/{chatId}/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.email in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberEmails;
      allow write: if request.auth != null && request.auth.uid == userId && request.auth.token.email in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberEmails && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
